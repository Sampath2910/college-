# -------------------------------------------------------------
# ProjectShelf - Environment Configuration Reference
# Copy to .env for local deployment
# -------------------------------------------------------------

# Database Configuration (MySQL 8.4)
DB_URL=jdbc:mysql://localhost:3306/projectshelf?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&connectionTimeZone=UTC
DB_USERNAME=projectshelf
DB_PASSWORD=your_secure_mysql_password
DB_ROOT_PASSWORD=your_secure_root_password

# Initial Administrator Credentials (Bootstrapped automatically on first startup)
ADMIN_EMAIL=admin@projectshelf.com
ADMIN_PASSWORD=ChangeMeToAStrongPassword123!

# Internal Python AI Service (FastAPI)
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=generate-a-secure-random-32-byte-token
AI_PROVIDER=anthropic
AI_MODEL=claude-haiku-5-5
# Required only for live model calls (the platform operates in heuristic fallback mode without it)
ANTHROPIC_API_KEY=

# Public Frontend & Backend URLs
APP_PUBLIC_URL=http://localhost:3000
BACKEND_URL=http://localhost:8080
NEXT_PUBLIC_SITE_NAME=ProjectShelf
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=

# External API Integrations (Optional credentials for increased limits & messaging)
# 1. GitHub API (Increases rate limits from 60 to 5,000 req/hr)
GITHUB_TOKEN=

# 2. Kaggle API (Enables private notebook and competition indexing)
KAGGLE_USERNAME=
KAGGLE_KEY=
KAGGLE_API_TOKEN=

# 3. Resend Email Service (Transactional notification emails & enquiry updates)
RESEND_API_KEY=
APP_MAIL_FROM=support@projectshelf.com

# 4. WhatsApp Business Cloud API (Direct student messaging & alerts)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

